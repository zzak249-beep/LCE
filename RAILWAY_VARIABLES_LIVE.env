# ===== PERFIL LIVE CONSERVADOR: úsalo solo tras días en signals y semanas en demo =====
# ===== Obligatorias =====
# signals (solo Telegram) | demo (VST sandbox) | live
TRADE_MODE=live
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Solo para demo/live (permisos: Leer + Trade. NUNCA retiros)
BINGX_API_KEY=
BINGX_API_SECRET=
# monta un Volume de Railway en /data
STATE_DIR=/data
# Cerrojo de dinero real: para activar live escribe EXACTAMENTE SI_ENTIENDO_EL_RIESGO
CONFIRM_LIVE=
# true = no abre operaciones nuevas (sigue gestionando las abiertas). Boton de pánico.
KILL_SWITCH=false

# ===== Universo =====
SYMBOLS=ALL
# USDT 24h
MIN_QUOTE_VOLUME=20000000
MAX_SYMBOLS=60
# pega aquí tu lista completa de la flota
NON_CRYPTO_PREFIXES=NCSK,NCFX,NCCO,NCSI

# ===== Riesgo =====
RISK_PCT=0.5
MAX_LEV=3
LEVERAGE=3
MAX_POSITIONS=2
# % (0 = off)
MAX_DAY_LOSS=3
MAX_TRADES_DAY=6
MAX_CONS_LOSS=3
PAUSE_BARS=36

# ===== Estrategia (defaults = LCE v2 / v8 con todo apagado) =====
TIMEFRAME=5m
USE_HTF=true
HTF_INTERVAL=1h
USE_VOL=true
VOL_MULT=1.2
BODY_MULT=0.5
WICK_RATIO=0.35
USE_SLOPE=true
MIN_RR=1.2
RR_FALLBACK=2.0
SL_BUFFER=0.3
COOLDOWN=6
USE_BREAKOUT=true
USE_REVERSION=true
USE_SWEEP_SIG=false

# ===== Módulos opcionales (todos off, como en el Pine) =====
# Multiplo | Kernel
VOL_MODE=Multiplo
USE_ADX=false
USE_FLOW=false
USE_SQZ=false
USE_E200_DIR=false
USE_E200_EXT=false
USE_E200_RV=false
USE_E200_TP=false
REV_NEED_DIV=false
REV_NEED_SWEEP=false
USE_STRUCT_BO=false
USE_STRUCT_EXIT=false
USE_PARTIAL=false
USE_BE=false
USE_TRAIL=false
MAX_BARS=0
