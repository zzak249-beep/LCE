# ===== Obligatorias =====
TRADE_MODE=signals            # signals (solo Telegram) | demo (VST sandbox) | live
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Solo para demo/live (permisos: Leer + Trade. NUNCA retiros)
BINGX_API_KEY=
BINGX_API_SECRET=
STATE_DIR=/data               # monta un Volume de Railway en /data

# ===== Universo =====
SYMBOLS=ALL
MIN_QUOTE_VOLUME=5000000      # USDT 24h
MAX_SYMBOLS=150
NON_CRYPTO_PREFIXES=NCSK,NCFX,NCCO,NCSI   # pega aquí tu lista completa de la flota

# ===== Riesgo =====
RISK_PCT=1.0
MAX_LEV=5
LEVERAGE=5
MAX_POSITIONS=5
MAX_DAY_LOSS=0                # % (0 = off)
MAX_TRADES_DAY=0
MAX_CONS_LOSS=0
PAUSE_BARS=36

# ===== Estrategia (defaults = LCE v2 / v8 con todo apagado) =====
TIMEFRAME=5m
USE_HTF=true
HTF_INTERVAL=1h
USE_VOL=true
VOL_MULT=1.2
BODY_MULT=0.5
WICK_RATIO=0.35
USE_SLOPE=true
MIN_RR=1.2
RR_FALLBACK=2.0
SL_BUFFER=0.3
COOLDOWN=6
USE_BREAKOUT=true
USE_REVERSION=true
USE_SWEEP_SIG=false

# ===== Módulos opcionales (todos off, como en el Pine) =====
VOL_MODE=Multiplo             # Multiplo | Kernel
USE_ADX=false
USE_FLOW=false
USE_SQZ=false
USE_E200_DIR=false
USE_E200_EXT=false
USE_E200_RV=false
USE_E200_TP=false
REV_NEED_DIV=false
REV_NEED_SWEEP=false
USE_STRUCT_BO=false
USE_STRUCT_EXIT=false
USE_PARTIAL=false
USE_BE=false
USE_TRAIL=false
MAX_BARS=0
